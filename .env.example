# ===== Promo Finder: API keys =====
# Add any you have. Providers with no key are skipped automatically, and every role falls over to
# the next provider/model the moment one hits its quota, so more keys = a run that never stops.
# Check what works with:  python doctor.py

# Google Gemini (strongest free option here; 20 requests/day per model): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral, free "Experiment" plan (phone verification): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter, models ending in ":free" (a small one-time credit raises the daily cap): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Groq (very fast; small per-minute token limits, so used for judging): https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (very fast; small context on free tier): https://cloud.cerebras.ai  -> API Keys
CEREBRAS_API_KEY=
# GitHub Models (fine-grained token with "Models: read"): https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=
# Hugging Face Inference Providers (small free monthly credit): https://huggingface.co/settings/tokens
HF_TOKEN=
# Local Ollama (free, unlimited, slower; run `ollama pull qwen2.5:14b`): https://ollama.com/download
# OLLAMA_ENABLED=1

# ===== Optional: override the model chains (comma-separated provider:model, first = preferred) =====
# LLM_PROPOSE_CHAIN=gemini:gemini-3-flash-preview,mistral:mistral-large-latest,openrouter:deepseek/deepseek-chat-v3-0324:free
# LLM_JUDGE_CHAIN=gemini:gemini-3.1-flash-lite,groq:llama-3.3-70b-versatile,cerebras:llama-3.3-70b
# LLM_AUDIT_CHAIN=mistral:mistral-large-latest,gemini:gemini-3-flash-preview

# ===== Optional: speed / limits =====
# PROMO_WORKERS=4          # parallel requests
# LLM_PATIENCE=4           # seconds to wait for a model's rate slot before using the next model
# LLM_MAX_WAIT=120         # if EVERY model is cooling down, wait at most this long
# GROQ_MAX_INPUT=10000     # per-provider overrides: <PROVIDER>_RPM / _MAX_INPUT / _TIMEOUT / _BASE_URL
