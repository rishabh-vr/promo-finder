# Provider preset: gemini | groq | openrouter | anthropic | openai  (or set LLM_BASE_URL yourself)
LLM_PRESET=gemini
LLM_API_KEY=
# LLM_BASE_URL=
# Optional model chains per role. First = preferred; the next is used automatically when a model's
# daily quota runs out or it is overloaded. Use a DIFFERENT model for the judge than the generator.
# LLM_PROPOSE_MODELS=gemini-3-flash-preview,gemini-3.8-flash
# LLM_JUDGE_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Free tiers are rate limited; lower this if you see 429s
LLM_RPM=8
